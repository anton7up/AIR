# Create .env next to this file. Never commit the real file.
# Public DNS name only, without https:// or a trailing slash.
PUBLIC_HOST=
BOT_TOKEN=
DATABASE_URL=sqlite+aiosqlite:///./air.db
MINI_APP_URL=
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
APP_ENV=development
# Local-only auth bypass. It is always disabled unless APP_ENV is development.
DEV_AUTH_ENABLED=false
DEV_PROGRAM_MODE=false
# Comma-separated Telegram IDs, for example: ID_1,ID_2
DEV_TELEGRAM_IDS=
# Closed-beta access. Server-side only; never expose this list in the frontend bundle.
TESTER_ACCESS_ENABLED=false
TESTER_TELEGRAM_IDS=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
SUPPORT_URL=
TERMS_URL=
PRIVACY_URL=

# Production VPS example (replace air.example.com and BOT_TOKEN):
# PUBLIC_HOST=air.example.com
# BOT_TOKEN=
# DATABASE_URL=sqlite+aiosqlite:////data/air.db
# MINI_APP_URL=https://air.example.com/mini-app/
# API_HOST=0.0.0.0
# API_PORT=8000
# APP_ENV=production
# DEV_AUTH_ENABLED=false
# DEV_PROGRAM_MODE=true
# DEV_TELEGRAM_IDS=ID_1,ID_2
# TESTER_ACCESS_ENABLED=true
# TESTER_TELEGRAM_IDS=FRIEND_ID_1,FRIEND_ID_2
# CORS_ORIGINS=https://air.example.com
# TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
